# Copy to .env.local for local development. Never commit a filled-in copy --
# .gitignore already excludes .env*, and this repository is public.
#
# In production these are set in Vercel: Project -> Settings -> Environment
# Variables. They are read at runtime by route handlers under app/api/, so a
# value change takes effect on redeploy without a source edit.

# Vercel KV — content store. Optional: lib/store.ts falls back to the
# bundled data/ fixtures when either of these is unset.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Spreaker API key — podcast publishing and show analytics.
# Consumed by lib/spreaker.ts and lib/spreaker-analytics.ts.
SPREAKER_API_KEY=

# YouTube Data API v3 key — channel and video stats.
# Consumed by lib/youtube-analytics.ts.
# Restrict this key in the Google Cloud console (API restriction: YouTube
# Data API v3) so a leaked copy cannot reach unrelated Google APIs.
YOUTUBE_API_KEY=

# Instagram Graph API — optional; lib/instagram-analytics.ts degrades to
# placeholder data when unset.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
